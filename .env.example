# ======================
# LLM Configuration
# ======================
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ======================
# Trading Platforms
# ======================
MT5_SERVER=ICMarkets-Demo
MT5_LOGIN=
MT5_PASSWORD=
MT5_PATH=C:\Program Files\FxPro - MT5\
TRADINGVIEW_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ======================
# Data Sources
# ======================
POLYGON_API_KEY=
YAHOO_FINANCE_USE_API=true
DUKASCOPY_BASE_URL=https://datafeed.dukascopy.com/datafeed/

# ======================
# Colab & Kaggle
# ======================
COLAB_NOTEBOOK_ID=
KAGGLE_USERNAME=
KAGGLE_API_KEY=
GOOGLE_COLAB_AUTH_TOKEN=

# ======================
# System Configuration
# ======================
MAX_AGENTS=10
AGENT_TIMEOUT=3600
BACKTEST_LOOKBACK_YEARS=5
MIN_SHARPE_RATIO=1.0
MAX_DRAWDOWN_PCT=30
WALK_FORWARD_PERIODS=5

# ======================
# Database & Cache
# ======================
REDIS_URL=redis://localhost:6379
DATABASE_URL=sqlite:///./trading_agent.db
POSTGRES_URL=postgresql://user:password@localhost:5432/trading_agent

# ======================
# Backtesting Config
# ======================
BACKTEST_ENGINE=quantconnect
VECTORIZED_BACKTESTER=true
CALCULATE_OPTIMIZATION_METRICS=true

# ======================
# Logging & Monitoring
# ======================
LOG_LEVEL=INFO
DEBUG_MODE=false
LOG_DIR=./logs
MONITOR_AGENT_PERFORMANCE=true

# ======================
# Security
# ======================
SECRET_KEY=your-secret-key-change-this
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ======================
# Agent Roles & Features
# ======================
ENABLE_STRATEGY_GENERATOR=true
ENABLE_DATA_DOWNLOADER=true
ENABLE_BACKTESTING_CRITIC=true
ENABLE_ML_TRAINER=true
ENABLE_RESEARCH_AGENT=true
ENABLE_VERIFIER_AGENT=true
ENABLE_DEPLOYMENT_AGENT=true
ENABLE_PORTFOLIO_MANAGER=true
